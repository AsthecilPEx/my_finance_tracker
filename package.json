{
  "name": "pulse-finance",
  "productName": "Pulse Finance",
  "version": "0.3.0",
  "description": "A smart personal finance tracker for Windows: category meters, payday calendar, bills, debts, insights and a desktop widget.",
  "author": "Pulse Finance",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "vitest run",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --dir"
  },
  "build": {
    "appId": "app.pulsefinance.desktop",
    "productName": "Pulse Finance",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "src/engine/**",
      "build/icon.png",
      "package.json",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**",
      "!node_modules/tesseract.js-core/*-lstm.{js,wasm,wasm.js}",
      "!node_modules/tesseract.js-core/*.asm.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "papaparse": "^5.7.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  }
}
